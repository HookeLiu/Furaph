# ============================================
# Furaph .gitignore
# ============================================

# ── Python ──────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.lock
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── 虚拟环境 ────────────────────────────────
venv/
ENV/
env/
.venv/

# ── IDE ─────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ──────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── 日志 ────────────────────────────────────
*.log
data/logs/
data/audit_logs/

# ── 临时文件 ────────────────────────────────
temp/
*.tmp
# 编辑器临时备份
*.bak.2*
__bak*
*.py.bak.*

# ── 密钥与本地配置（防御性）────────────────
**/secrets*.yaml
**/model_router_secrets.yaml
**/.env
**/.env.*
!**/.env.example
!**/config.example.yaml

# ── 子仓接入 ────────────────────────────────
# Furaph-Core 通过 git submodule 引用；勿再整目录 ignore
# 子仓内 .venv/data/secrets 由子仓自身 .gitignore 处理

